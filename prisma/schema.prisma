generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Territory {
  id           String             @id @default(uuid())
  name         String             @unique
  division     String             @default("Challengers")
  performances DailyPerformance[]
  mvps         PlayerMVP[]
  matchesA     Match[]            @relation("TerritoryA")
  matchesB     Match[]            @relation("TerritoryB")
}

model DailyPerformance {
  id                       String    @id @default(uuid())
  date                     DateTime
  territoryId              String
  newSalesFoton            Int       @default(0)
  newSalesMahindra         Int       @default(0)
  resale                   Int       @default(0)
  salesPerformanceScore    Float     @default(0)
  recoveryPerformanceScore Float     @default(0)
  mahindraBonusScore       Float     @default(0)
  totalDailyScore          Float     @default(0)
  
  territory Territory @relation(fields: [territoryId], references: [id])

  @@unique([date, territoryId])
}

model PlayerMVP {
  id          String   @id @default(uuid())
  date        DateTime
  territoryId String
  playerName  String
  imagePath   String

  territory Territory @relation(fields: [territoryId], references: [id])
}

model Match {
  id           String   @id @default(uuid())
  date         DateTime
  territoryAId String
  territoryBId String
  scoreA       Float    @default(0)
  scoreB       Float    @default(0)

  territoryA Territory @relation("TerritoryA", fields: [territoryAId], references: [id])
  territoryB Territory @relation("TerritoryB", fields: [territoryBId], references: [id])
}

model SpotlightConfig {
  id              String @id @default("default")
  strikerName     String @default("")
  goalkeeperName  String @default("")
  strikerImage    String @default("")
  goalkeeperImage String @default("")
}
